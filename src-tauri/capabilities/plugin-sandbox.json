{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugin-sandbox",
  "description": "Least-privilege sandbox capability for child plugin webviews (SPEC-016-R4).",
  "webviews": ["plugin-*"],
  "permissions": [
    "aitools:guest-sandbox",
    "core:window:allow-close",
    "core:event:default",
    "dialog:default",
    "notification:default",
    "opener:default"
  ]
}
