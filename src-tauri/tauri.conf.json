{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "aitools",
  "version": "0.1.0",
  "identifier": "dev.aitools.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @aitools/renderer-svelte dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @aitools/renderer-svelte build",
    "frontendDist": "../packages/renderer-svelte/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "aitools",
        "url": "/",
        "width": 780,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false
      },
      {
        "label": "dsh",
        "title": "aitools Developer & Diagnostic Harness",
        "url": "/#dsh",
        "width": 960,
        "height": 640,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true
      },
      "csp": "default-src 'self'; img-src 'self' data: aitools-plugin:; connect-src 'self' aitools-plugin: aitools-sync:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MjIwNkFERkYwQTc0QzEKUldUQmRBci9yUVlpZEw5Uk5NRmt4TUYraHlpczdTNmVhQkowZ1RObGhXbEY1UmhCOHhWLzg2S20K"
    }
  }
}
