{
  "id": "dev-docs-reference",
  "name": "Developer Quick Reference",
  "version": "1.0.0",
  "runtime": "native-ui",
  "main": "index.html",
  "permissions": ["db.read", "db.write", "ai.fast"],
  "ai_tools": [
    {
      "name": "lookup_dev_doc",
      "description": "Search built-in cheat sheets for Rust std, Tauri v2 ACLs, HTTP codes, and regex.",
