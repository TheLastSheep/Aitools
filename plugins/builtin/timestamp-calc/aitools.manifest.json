{
  "id": "timestamp-calc",
  "name": "Timestamp & Expression Calculator",
  "version": "1.0.0",
  "runtime": "rust-wasm",
  "wasm_entry": "plugin.wasm",
  "permissions": ["clipboard.read", "clipboard.write"],
  "ai_tools": [
    {
      "name": "convert_timestamp",
      "description": "Convert Unix epoch seconds/milliseconds to ISO-8601 UTC timestamps.",
      "risk_tier": "tier0_read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "epoch": { "type": "number" }
        },
        "required": ["epoch"]
      }
    },
    {
      "name": "eval_expression",
      "description": "Evaluate deterministic integer and floating-point arithmetic expressions.",
      "risk_tier": "tier0_read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "expr": { "type": "string" }
        },
        "required": ["expr"]
      }
    }
  ],
  "skill_file": "SKILL.md"
}
