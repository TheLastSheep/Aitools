{
  "id": "terminal-launchpad",
  "name": "Terminal Shortcuts & Project Launchpad",
  "version": "1.1.0",
  "runtime": "native-ui",
  "main": "index.html",
  "permissions": ["shell.exec", "db.read", "db.write", "ai.fast"],
  "ai_tools": [
    {
      "name": "list_project_shortcuts",
      "description": "List saved project directories, dev-server commands, and local port bindings.",
      "risk_tier": "tier0_read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "filter": { "type": "string" }
        }
      }
    },
    {
      "name": "register_terminal_shortcut",
      "description": "Persist a named terminal command shortcut for fast launching.",
      "risk_tier": "tier1_state_mutating",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "cwd": { "type": "string" },
          "command": { "type": "string" }
        },
        "required": ["name", "command"]
      }
    }
  ],
  "skill_file": "SKILL.md"
}
