{
  "id": "smart-clip",
  "name": "Smart Clipboard Vault",
  "version": "0.1.0",
  "runtime": "native-ui",
  "main": "index.html",
  "permissions": ["clipboard.read", "clipboard.write", "db.read", "db.write", "ai.fast"],
  "ai_tools": [
    {
      "name": "save_clip",
      "description": "Persist the current selection or clipboard snippet into isolated LMDB storage.",
      "risk_tier": "tier1_state_mutating",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        },
        "required": ["id", "text"]
      }
    }
  ],
  "skill_file": "SKILL.md"
}
